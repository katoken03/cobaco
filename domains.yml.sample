# domains.yml
# このファイルで全ドメインを宣言的に管理します。
# add-domain.sh がこのファイルを読み込んで Nginx 設定・SSL などを自動構成します。
#
# フィールド説明:
#   name         : ドメイン名 (必須)
#   type         : "php" または "nodejs" (必須)
#   php_version  : "8.5" / "8.3" / "7.4" など (type: php のとき必須)
#                  Ubuntu 26.04 の公開サイトは 8.5、24.04 は公式最新の 8.3
#   port         : Node.js アプリのリッスンポート (type: nodejs のとき必須)
#   pm2_name     : PM2 プロセス名 (type: nodejs のとき必須)
#   www_redirect : true の場合 www.{domain} → {domain} へリダイレクト (省略時: false)
#   ssl          : true の場合 Let's Encrypt で証明書取得 (省略時: false)
#   basic_auth   : サイト全体のベーシック認証 (省略時: 無効)
#     title      : 認証ダイアログに表示するタイトル (必須)
#     users      : ユーザー一覧 (1 人以上)
#       id       : ログイン ID (必須)
#       password : パスワード (必須。domains.yml は .gitignore 対象のため git に含めない)

domains:
  - name: example.com
    type: php
    php_version: "8.5"
    www_redirect: true
    ssl: true

  - name: staging.example.com
    type: php
    php_version: "8.5"
    www_redirect: false
    ssl: true
    basic_auth:
      title: "Restricted"
      users:
        - id: admin
          password: "change-me"

  - name: legacy.example.com
    type: php
    php_version: "7.4"
    www_redirect: false
    ssl: true

  - name: app.example.com
    type: nodejs
    port: 3000
    pm2_name: app-example
    www_redirect: false
    ssl: true
