# domains.yml
# このファイルで全ドメインを宣言的に管理します。
# add-domain.sh / deploy.sh が読み込んで Nginx 設定・SSL・デプロイ先を自動構成します。
#
# 配置: /root/cobaco_config/domains.yml（Git 外。clone/pull しても残る）
# 初回: この sample をコピーして編集する。
# 本番で cobaco が読む場合: chmod 711 /root && chmod 644 /root/cobaco_config/domains.yml
#
# フィールド説明:
#   name         : ドメイン名 (必須)
#   type         : "php" または "nodejs" (必須)
#   php_version  : "8.5" / "8.3" / "8.2" / "7.4" / "7.3" など (type: php のとき必須)
#                  Ubuntu 26 以降の PHP 8.5 / 7.3 / 7.4 / 8.2 / 8.3 は packages.sury.org
#                  24.04 は公式最新の 8.3 と 7.4（ondrej/php PPA）
#   port         : Node.js アプリのリッスンポート (type: nodejs のとき必須)
#   pm2_name     : PM2 プロセス名 (type: nodejs のとき必須)
#   www_redirect   : true の場合 server_name に www.{domain} を追加 (省略時: false)
#   ssl            : true の場合 Let's Encrypt で証明書取得 (省略時: false)
#   ssl_subdomains : ssl: true のとき、証明書と server_name に載せる追加 FQDN の配列 (省略可)
#                    各要素は *.name 形式 (例: api.example.com)。apex (name 自体) は不要
#                    www_redirect: true かつ ssl: true のときは www.{domain} を必ず含める
#                    別名は同じ vhost (同じドキュメントルート) で応答する
#   php_settings : type: php のとき任意。Web (PHP-FPM) のみに効く ini 差分
#                  省略したキーはその php_version 共通設定のまま
#                  例: memory_limit, upload_max_filesize, post_max_size,
#                      max_execution_time, display_errors など (DOC.md 参照)
#   basic_auth   : サイト全体のベーシック認証 (省略時: 無効)
#     title      : 認証ダイアログに表示するタイトル (必須)
#     users      : ユーザー一覧 (1 人以上)
#       id       : ログイン ID (必須)
#       password : パスワード (必須。実ファイルは git に含めない)
#   mysql        : MariaDB のデータベースと専用ユーザー (省略可。配列)
#                  apply-mysql.sh / add-domain.sh が適用。アプリの .env は自動生成しない
#     database   : データベース名 (必須。サーバー全体で一意)
#     user       : その DB 専用ユーザー (必須。サーバー全体で一意)
#     password   : パスワード (必須。domains.yml は Git 外で管理)
#     charset    : 新規 CREATE 時のみ (省略時: utf8mb4)
#     collation  : 新規 CREATE 時のみ (省略時: utf8mb4_unicode_ci)
#                  宣言から外しても DB / ユーザーは DROP しない (DOC.md 参照)

domains:
  - name: example.com
    type: php
    php_version: "8.5"
    www_redirect: true
    ssl: true
    ssl_subdomains:
      - www.example.com
      - api.example.com
      - blog.example.com

  - name: staging.example.com
    type: php
    php_version: "8.5"
    www_redirect: false
    ssl: true
    php_settings:
      memory_limit: 256M
      upload_max_filesize: 64M
      post_max_size: 64M
      max_execution_time: 120
      display_errors: "Off"
    basic_auth:
      title: "Restricted"
      users:
        - id: admin
          password: "change-me"
    mysql:
      - database: staging_example
        user: staging_example
        password: "change-me-db"

  - name: legacy.example.com
    type: php
    php_version: "7.4"
    www_redirect: false
    ssl: true

  - name: app.example.com
    type: nodejs
    port: 3000
    pm2_name: app-example
    www_redirect: false
    ssl: true
