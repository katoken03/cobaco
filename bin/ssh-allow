#!/usr/bin/env bash
# ssh-allow — SSH を許可する接続元 IP の一覧・追加・削除 (root)
# 使い方:
#   ssh-allow                    番号メニュー (ConoHa コンソール向け)
#   ssh-allow list               一覧と UFW の状態
#   ssh-allow add <IP|CIDR> [メモ]
#   ssh-allow remove <番号|IP>
#   ssh-allow apply              許可リストを UFW / fail2ban に再適用
#   ssh-allow off                絞り込みをやめて SSH を全体に公開 (リストは退避して残す)
#   ssh-allow on                 退避したリストで絞り込みを再開
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC}   $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# リポジトリ: cobaco/bin/ssh-allow → lib は ../lib
# 本番: /usr/local/sbin/ssh-allow → /usr/local/lib/cobaco/ssh-allow.sh
if [[ -f "${SCRIPT_DIR}/../lib/ssh-allow.sh" ]]; then
    # shellcheck source=lib/ssh-allow.sh
    source "${SCRIPT_DIR}/../lib/ssh-allow.sh"
elif [[ -f "/usr/local/lib/cobaco/ssh-allow.sh" ]]; then
    # shellcheck source=/usr/local/lib/cobaco/ssh-allow.sh
    source "/usr/local/lib/cobaco/ssh-allow.sh"
else
    error "ssh-allow.sh が見つかりません。"
    exit 1
fi

if [[ $EUID -ne 0 ]]; then
    error "このコマンドは root で実行してください。"
    exit 1
fi

# 同時に 2 つ動かしてリストや UFW を壊さないようにする
exec 9>/run/lock/cobaco-ssh-allow.lock
if ! flock -n 9; then
    error "別の ssh-allow が実行中です。"
    exit 1
fi

# 編集対象のリスト: オフ中は退避したリスト、それ以外は有効なリスト
list_file() {
    if [[ "$(ssh_allow_state)" == off ]]; then
        echo "$SSH_ALLOW_DISABLED"
    else
        echo "$SSH_ALLOW_LIST"
    fi
}

# 一時ファイルの内容でリストを置き換える (600)
replace_list() {
    local tmp="$1" dest="$2"
    mkdir -p "$(dirname "$dest")"
    install -m 600 "$tmp" "$dest"
    rm -f "$tmp"
}

cmd_list() {
    local state file
    state="$(ssh_allow_state)"
    file="$(list_file)"
    case "$state" in
        on)    echo "状態: オン (許可リストの IP からのみ SSH を受け付ける)" ;;
        off)   echo "状態: オフ (ssh-allow off により SSH を全体に公開中)" ;;
        unset) echo "状態: 未設定 (SSH は全体に公開。ssh-allow add で絞り込みを開始)" ;;
    esac

    local -a entries=()
    mapfile -t entries < <(ssh_allow_read_list "$file")
    echo
    echo "許可リスト (${file}):"
    if ((${#entries[@]} == 0)); then
        echo "  (なし)"
    else
        local i=1 entry
        for entry in "${entries[@]}"; do
            printf '  %d) %-20s %s\n' "$i" "${entry%%$'\t'*}" "${entry#*$'\t'}"
            ((i++))
        done
    fi

    echo
    echo "UFW の SSH ルール:"
    local -a rules=()
    mapfile -t rules < <(ssh_allow_ufw_rules)
    local -A in_ufw=()
    local rule rule_port proto src app norm open=false
    for rule in "${rules[@]}"; do
        IFS=$'\t' read -r rule_port proto src app <<< "$rule"
        if [[ "$app" != "-" ]]; then
            printf '  %s/%s  %s (全体に公開)\n' "$rule_port" "$proto" "$app"
            open=true
        elif [[ "$src" == "any" ]]; then
            printf '  %s/%s  Anywhere (全体に公開)\n' "$rule_port" "$proto"
            open=true
        else
            printf '  %s/%s  %s\n' "$rule_port" "$proto" "$src"
            norm="$(ssh_allow_normalize "$src" || true)"
            in_ufw["$norm"]=1
        fi
    done
    ((${#rules[@]} == 0)) && echo "  (なし)"

    [[ "$state" == on ]] || return 0
    local drift="$open" addr
    for entry in "${entries[@]}"; do
        addr="$(ssh_allow_normalize "${entry%%$'\t'*}" || true)"
        [[ -n "$addr" && -n "${in_ufw[$addr]:-}" ]] || drift=true
    done
    if [[ "$drift" == true ]]; then
        echo
        warn "許可リストと UFW がずれています。ssh-allow apply で同期できます。"
    fi
}

cmd_add() {
    local raw="${1:-}" memo="${2:-}"
    if [[ -z "$raw" ]]; then
        error "追加する IP を指定してください。例: ssh-allow add 203.0.113.5 office"
        return 1
    fi
    local addr
    if ! addr="$(ssh_allow_normalize "$raw")"; then
        error "IP アドレスとして正しくありません: ${raw}"
        return 1
    fi
    memo="${memo//[$'\t\r\n#']/ }"

    local state file entry
    state="$(ssh_allow_state)"
    file="$(list_file)"
    while IFS= read -r entry; do
        if [[ "$(ssh_allow_normalize "${entry%%$'\t'*}" || true)" == "$addr" ]]; then
            warn "${addr} は既に登録されています。"
            return 0
        fi
    done < <(ssh_allow_read_list "$file")

    local tmp
    tmp="$(mktemp)"
    if [[ -f "$file" ]]; then
        cat "$file" > "$tmp"
    else
        echo "# ssh-allow: SSH を許可する接続元 (IP または CIDR  メモ)" > "$tmp"
    fi
    printf '%s\t%s\n' "$addr" "$memo" >> "$tmp"
    replace_list "$tmp" "$file"
    success "追加しました: ${addr} ${memo}"

    if [[ "$state" == off ]]; then
        info "絞り込みはオフのため UFW には反映していません。ssh-allow on で有効になります。"
        return 0
    fi
    ssh_allow_apply
}

cmd_remove() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        error "削除する番号か IP を指定してください。例: ssh-allow remove 2"
        return 1
    fi
    local state file
    state="$(ssh_allow_state)"
    file="$(list_file)"
    local -a entries=()
    mapfile -t entries < <(ssh_allow_read_list "$file")
    if ((${#entries[@]} == 0)); then
        error "許可リストは空です。"
        return 1
    fi
    if [[ "$state" == on ]] && ((${#entries[@]} <= 1)); then
        error "最後の 1 件は削除できません。先に新しい IP を追加するか、ssh-allow off で絞り込みをやめてください。"
        return 1
    fi

    local addr="" i
    if [[ "$target" =~ ^[0-9]+$ ]] && ((target >= 1 && target <= ${#entries[@]})); then
        addr="$(ssh_allow_normalize "${entries[target - 1]%%$'\t'*}" || true)"
    else
        local want
        want="$(ssh_allow_normalize "$target" || true)"
        for i in "${!entries[@]}"; do
            if [[ -n "$want" && "$(ssh_allow_normalize "${entries[i]%%$'\t'*}" || true)" == "$want" ]]; then
                addr="$want"
                break
            fi
        done
    fi
    if [[ -z "$addr" ]]; then
        error "許可リストに見つかりません: ${target}"
        return 1
    fi

    # 今の SSH 接続元を消そうとしていないか確認する
    local client="${SSH_CLIENT%% *}"
    if [[ "$state" == on && -n "$client" ]] && python3 -I -c '
import ipaddress, sys
sys.exit(0 if ipaddress.ip_address(sys.argv[1]) in ipaddress.ip_network(sys.argv[2], strict=False) else 1)
' "$client" "$addr" 2>/dev/null; then
        warn "${addr} には今の SSH 接続元 ${client} が含まれます。削除すると次回から接続できません。"
        local answer
        read -r -p "本当に削除しますか? [y/N]: " answer
        [[ "$answer" == "y" || "$answer" == "Y" ]] || { info "中止しました。"; return 0; }
    fi

    local tmp
    tmp="$(mktemp)"
    awk -v addr="$addr" '
        {
            line = $0
            sub(/#.*/, "", line)
            split(line, f, /[ \t]+/)
            a = (f[1] == "" ? f[2] : f[1])
            sub(/\/(32|128)$/, "", a)
            if (a == addr) next
            print
        }
    ' "$file" > "$tmp"
    if cmp -s "$tmp" "$file"; then
        rm -f "$tmp"
        error "${file} から ${addr} の行を特定できませんでした。ファイルを直接確認してください。"
        return 1
    fi
    replace_list "$tmp" "$file"
    success "削除しました: ${addr}"
    [[ "$state" == on ]] && ssh_allow_apply
    return 0
}

cmd_off() {
    local state
    state="$(ssh_allow_state)"
    if [[ "$state" == off ]]; then
        info "絞り込みは既にオフです。"
        return 0
    fi
    if [[ "$state" == on ]]; then
        warn "SSH の接続元の絞り込みをやめ、全体に公開します (公開鍵認証と fail2ban は有効のまま)。"
        local answer
        read -r -p "オフにしますか? [y/N]: " answer
        [[ "$answer" == "y" || "$answer" == "Y" ]] || { info "中止しました。"; return 0; }
    fi
    ssh_allow_open
    # リストは退避して残す (未設定からのオフは空の退避ファイルを「意図して公開中」の印にする)
    if [[ -f "$SSH_ALLOW_LIST" ]]; then
        mv "$SSH_ALLOW_LIST" "$SSH_ALLOW_DISABLED"
    else
        mkdir -p "$(dirname "$SSH_ALLOW_DISABLED")"
        install -m 600 /dev/null "$SSH_ALLOW_DISABLED"
    fi
    success "絞り込みをオフにしました。リストは ${SSH_ALLOW_DISABLED} に退避しています。"
}

cmd_on() {
    local state
    state="$(ssh_allow_state)"
    if [[ "$state" == on ]]; then
        info "絞り込みは既にオンです。"
        ssh_allow_apply
        return
    fi
    if [[ -z "$(ssh_allow_read_list "$SSH_ALLOW_DISABLED")" ]]; then
        error "許可する IP がありません。先に ssh-allow add <IP> <メモ> で追加してください。"
        return 1
    fi
    if [[ -f "$SSH_ALLOW_LIST" ]]; then
        # 中身の無い有効リストが残っていれば退避側を優先する
        rm -f "$SSH_ALLOW_LIST"
    fi
    mv "$SSH_ALLOW_DISABLED" "$SSH_ALLOW_LIST"
    success "絞り込みをオンにしました。"
    ssh_allow_apply
}

menu() {
    local choice ip memo target
    while true; do
        echo
        echo "===== SSH 許可 IP の管理 (状態: $(ssh_allow_state)) ====="
        echo "  1) 一覧"
        echo "  2) 追加"
        echo "  3) 削除"
        echo "  4) 再適用"
        echo "  5) 絞り込みオン/オフ切り替え"
        echo "  0) 終了"
        read -r -p "番号: " choice || return 0
        case "$choice" in
            1) cmd_list || true ;;
            2)
                read -r -p "追加する IP (例 203.0.113.5): " ip || continue
                read -r -p "メモ (省略可): " memo || memo=""
                cmd_add "$ip" "$memo" || true
                ;;
            3)
                cmd_list || true
                read -r -p "削除する番号: " target || continue
                cmd_remove "$target" || true
                ;;
            4) ssh_allow_apply || true ;;
            5)
                if [[ "$(ssh_allow_state)" == on ]]; then
                    cmd_off || true
                else
                    cmd_on || true
                fi
                ;;
            0) return 0 ;;
            *) warn "0〜5 の番号を入力してください。" ;;
        esac
    done
}

case "${1:-}" in
    "")     menu ;;
    list)   cmd_list ;;
    add)    shift; cmd_add "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    apply)  ssh_allow_apply ;;
    off)    cmd_off ;;
    on)     cmd_on ;;
    -h|--help|help)
        sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        ;;
    *)
        error "不明なサブコマンド: $1 (ssh-allow help で使い方を表示)"
        exit 1
        ;;
esac
